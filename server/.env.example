# ===== LLM 配置（OpenAI 兼容端点）=====
# 复制本文件为 .env 并填入真实值即可启用 LLM 改编。
# 留空 LLM_API_KEY 则进入 mock 模式：走原规则模板，不调外部接口。

# 1) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxx

# 2) DeepSeek（便宜、中文强）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx

# 3) Moonshot / Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
# LLM_API_KEY=sk-xxxx

# 4) 通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxx

# 5) 本地 Ollama（无需 key，先 `ollama serve` + `ollama pull qwen2.5`）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5
# LLM_API_KEY=ollama

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.7
